{
  "name": "owla-butler",
  "version": "3.8.0",
  "private": true,
  "keywords": ["obsidian-plugin","obsidian","ai","ai-assistant","ai-chat","chatbot","sidebar","copilot","llm","agent","codex","opencode","claude-code","hermes-agent","writing-assistant"],
  "description": "Obsidian sidebar assistant for Codex, OpenCode, Claude Code and Hermes Agent: current note context, attachments, vault search and reviewed edits",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "lint": "eslint src",
    "check:release": "node scripts/check-release.mjs",
    "guard": "node scripts/vault-guard.mjs",
    "guard:test": "node scripts/vault-guard.test.mjs"
  },
  "devDependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "6.43.13",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-obsidianmd": "^0.6.0",
    "obsidian": "1.14.4",
    "tsx": "^4.0.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.73.0"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "diff": "^9.0.0",
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1"
  },
  "author": "Filip (@pilafdob)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pilafdob/owla-butler.git"
  },
  "homepage": "https://github.com/pilafdob/owla-butler#readme",
